# Copy to .env (never committed) and fill in.

# The report stack (docker compose). MongoDB's root password; any long random string.
MONGO_PASSWORD=
# Bearer token that `fns publish` must send to add a run. Reads stay public. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
UPLOAD_TOKEN=
# Host port for the report (default 8088).
# WEB_PORT=8088

# Optional: faster model downloads on Colab (also settable as a Colab secret).
HF_TOKEN=
